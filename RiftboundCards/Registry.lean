module

public import Riftbound.Card.CardDB
public import RiftboundCards.Origins
public import RiftboundCards.ProvingGrounds
public import RiftboundCards.Spiritforged
public import RiftboundCards.Unleashed
public import RiftboundCards.Vendetta
public import RiftboundCards.Radiance
public import RiftboundCards.Tokens

/-!
# The card database

All the cards of all the sets. Generated by `scripts/gen_lean.py`.
-/

@[expose] public section

namespace RiftboundCards

open Riftbound

/-- Every card, set by set. -/
def allCards : List CardDef :=
  RiftboundCards.Origins.cards ++
    RiftboundCards.ProvingGrounds.cards ++
    RiftboundCards.Spiritforged.cards ++
    RiftboundCards.Unleashed.cards ++
    RiftboundCards.Vendetta.cards ++
    RiftboundCards.Radiance.cards

/-- The card database: the cards of the sets, and the tokens. -/
def db : CardDB := ⟨allCards ++ RiftboundCards.Tokens.cards⟩

end RiftboundCards

end
